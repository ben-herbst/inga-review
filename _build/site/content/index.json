{"version":3,"kind":"Article","sha256":"eaa418c59a9940e897d3bf44e26454343c73f61666e36981d80593b09fda759c","slug":"index","location":"/review.md","dependencies":[],"frontmatter":{"title":"Review: Machines that think by Inga Strumke 🇳🇴","content_includes_title":false,"authors":[{"id":"Ben Herbst","name":"Ben Herbst"}],"exports":[{"format":"md","filename":"review.md","url":"/review-01bf321bbbff2dcb733489a85aa63ade.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"container","kind":"quote","children":[{"type":"blockquote","position":{"start":{"line":3,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"I believe that basic knowledge about artificial intelligence will\nquickly become crucial for understanding much of what is happening\nin our lives and for being able to actively participate in the\npublic debate about how we want this technology to influence our\nsociety.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zIHMdUGwIz"}],"key":"xGX8apWswb"}],"key":"NIUhHMF3Kx"}],"key":"ONfnD5QEfm"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"abbreviation","title":"In, *Machines that Think*, p37","children":[{"type":"text","value":"Inga Strümke","key":"LK1G0ytTGD"}],"key":"oJrs4R7Xdf"}],"key":"yM4aQL2ZjR"}],"key":"HqcnFnFdCK"}],"key":"lD8YilZ0RT"},{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Preamble","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"yOGLvopFoS"}],"identifier":"preamble","label":"Preamble","html_id":"preamble","implicit":true,"key":"keWTgRXXel"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"One has to be completely ignorant to be unaware of the debate raging about ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"tqKD2MFj8X"},{"type":"abbreviation","title":"Artificial Inteliigence","children":[{"type":"text","value":"AI","key":"WT0AABJMtY"}],"key":"uPb9VgUNP2"},{"type":"text","value":" and how\nit is about to transform our\nsocieties. It doesn’t help that the big-tech leaders and researchers have wide-ranging opinions, even among themselves.\nHere is a random selection:","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"r0AbmuBx21"}],"key":"H2KEKkIxu0"},{"type":"container","kind":"quote","children":[{"type":"blockquote","children":[{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Artificial intelligence can be wondrous, but the technology underneath is more than a little monstrous.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"KLd3og2Y5q"}],"key":"Qoo97nAc8w"},{"type":"container","kind":"quote","children":[{"type":"blockquote","position":{"start":{"line":22,"column":1},"end":{"line":23,"column":1}},"children":[],"key":"qUQSDiwWlI"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"abbreviation","title":"The New York Times, 26 April 2026.","children":[{"type":"text","value":"Paul Ford","key":"mMSuNAGjpn"}],"key":"nwDZBpLaBd"}],"key":"u6vd1K6Nqz"}],"key":"j7gkHIEGe4"}],"key":"N5i9AxfMeX"}],"key":"MIBkElkIH8"}],"class":"pull-quote","key":"uBx22k2NWd"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Full quote","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"XfguO5ELvQ"}],"key":"jNiOHAicQc"},{"type":"container","kind":"quote","children":[{"type":"blockquote","position":{"start":{"line":28,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Artificial intelligence can be wondrous, but the technology\nunderneath is more than a little monstrous. It eats up all the words\nin the world, from blogs to books, often without permission. It\nburns whole forests’ worth of energy, digesting that raw material\ninto its models, and gulps billions of gallons of water to cool\ndown.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"HdSByC4Aul"}],"key":"JYhCxa7RXI"}],"key":"kiGajXkjZG"}],"key":"rIJYpzwofB"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"abbreviation","title":"The New York Times, 26 April 2026.","children":[{"type":"text","value":"Paul Ford","key":"P8ZjceULn1"}],"key":"IqLufbWLvs"}],"key":"bSWLUkxMK4"}],"key":"g4pV2yUcyZ"}],"key":"qijcc8KZl5"}],"class":"dropdown","key":"FeRJe1XEVB"},{"type":"container","kind":"quote","children":[{"type":"blockquote","children":[{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"the Anthropic chief “knows absolutely nothing about the effects\nof technological revolutions on the labour market\"","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"w5lxh68fA9"}],"key":"AcZzSFIs4a"},{"type":"container","kind":"quote","children":[{"type":"blockquote","position":{"start":{"line":41,"column":1},"end":{"line":42,"column":1}},"children":[],"key":"lzFzGT0UaZ"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"abbreviation","title":"Quoted in Business Today, 19 April 2026","children":[{"type":"text","value":"Yann LeCun","key":"XuqL2zmIKg"}],"key":"eH6u0oZpo8"}],"key":"FPm9qAkKO8"}],"key":"Z0ioORtdir"}],"key":"pT7ej83Gck"}],"key":"aJEulDoESc"}],"class":"pull-quote","key":"zSaL7bsjj5"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Full quote","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"m7qjgNEPt4"}],"key":"ELuA5eNw2C"},{"type":"container","kind":"quote","children":[{"type":"blockquote","position":{"start":{"line":47,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Yann LeCun, former chief scientist at Meta Platforms’s AI division,\nhas criticised Dario Amodei for warning that artificial intelligence\n(AI) could eliminate up to half of all tech jobs.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"FB4ML8AFXa"}],"key":"uQme6ep2mM"}],"key":"mUBvILksxz"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Responding to Amodei’s earlier remarks, LeCun said the Anthropic\nchief “knows absolutely nothing about the effects of technological\nrevolutions on the labour market,” adding that even AI leaders are\nnot qualified to predict employment outcomes.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"zDVjgjyiu3"}],"key":"UyLmb82Zcd"}],"key":"IjKYkQqOWj"}],"key":"iRvt3PXeNt"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{